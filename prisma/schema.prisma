// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  role          String?  @default("user")
  createdAt     DateTime
  updatedAt     DateTime

  sessions               Session[]
  accounts               Account[]
  reviews                Review[]
  generatedImages        GeneratedCharacterImage[]
  posts                  Post[]
  generatedBookCover     GeneratedBookCover[]
  coverLikes             CoverLike[]
  characterImageLikes    CharacterImageLike[]
  coverComments          CoverComment[]
  characterImageComments CharacterImageComment[]

  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@index([identifier])
}

model BookSeries {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  @@index([name])
  @@map("book_series")
}

model Book {
  id            String   @id @default(cuid())
  title         String
  authors       String // comma-separated list
  description   String?
  thumbnailUrl  String?
  language      String?
  publishedDate String?
  keyEvents     String[] @default([]) // ключевые события сюжета по порядку
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews               Review[]
  characters            Character[]
  characterDescriptions CharacterDescription[]
  posts                 Post[]
  bookSeriesId          String?
  bookSeries            BookSeries?            @relation(fields: [bookSeriesId], references: [id], onDelete: SetNull)

  generatedBookCover       GeneratedBookCover[]
  generatedCharacterImages GeneratedCharacterImage[]

  @@index([title])
}

model Post {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("post")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId, createdAt])
}

model Character {
  id        String   @id @default(cuid())
  name      String
  aliases   String[] @default([])
  createdAt DateTime @default(now())

  books                 Book[]
  generatedImages       GeneratedCharacterImage[]
  posts                 Post[]
  characterDescriptions CharacterDescription[]

  @@index([name])
}

enum CharacterTier {
  MAIN
  SECONDARY
  MINOR
}

model CharacterDescription {
  id          String        @id @default(cuid())
  description String
  appearance  String? // внешность по тексту книги
  personality String? // характер и манера поведения
  role        String? // функция персонажа в сюжете
  tier        CharacterTier @default(MINOR)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  characterId String
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, bookId])
  @@index([bookId, tier])
  @@unique([bookId, characterId])
  @@map("character_description")
}

model GeneratedBookCover {
  id        String   @id @default(cuid())
  blobUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prompt    String

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes    CoverLike[]
  comments CoverComment[]

  @@index([bookId])
}

model CoverComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  userId  String
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverId String
  cover   GeneratedBookCover @relation(fields: [coverId], references: [id], onDelete: Cascade)

  @@index([coverId, createdAt])
  @@map("cover_comment")
}

model CoverLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId  String
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverId String
  cover   GeneratedBookCover @relation(fields: [coverId], references: [id], onDelete: Cascade)

  @@unique([userId, coverId])
  @@index([coverId])
  @@map("cover_like")
}

model CharacterImageLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   GeneratedCharacterImage @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([characterId])
  @@map("character_image_like")
}

model CharacterImageComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterImageId String
  characterImage   GeneratedCharacterImage @relation(fields: [characterImageId], references: [id], onDelete: Cascade)

  @@index([characterImageId, createdAt])
  @@map("character_image_comment")
}

model GeneratedCharacterImage {
  id        String   @id @default(cuid())
  prompt    String
  blobUrl   String
  createdAt DateTime @default(now())

  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character               @relation(fields: [characterId], references: [id], onDelete: Cascade)
  likes       CharacterImageLike[]
  comments    CharacterImageComment[]
  bookId      String
  book        Book                    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, characterId])
  @@index([userId])
  @@index([characterId])
  @@index([bookId])
}
